# Line-ending normalization (audit finding P2-02).
# Baseline: treat all files as text and normalize to LF at the Git level,
# matching .editorconfig's `end_of_line = lf`.
* text=auto eol=lf

# Text-based formats that must not be misdetected as binary.
*.svg text eol=lf
*.webmanifest text eol=lf

# Binary assets: excluded from line-ending normalization and text diffing.
*.png binary
*.jpg binary
*.webp binary
*.avif binary
*.ico binary
*.woff2 binary
