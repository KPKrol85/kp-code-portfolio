{
  "name": "ds-construction-pr01-solidcraft",
  "version": "1.0.0",
  "private": true,
  "description": "SolidCraft — static front-end implementation of a construction company website (HTML, CSS, JavaScript, PostCSS).",
  "author": {
    "name": "Kamil Król | KP_Code Digital Studio",
    "email": "kontakt@kp-code.pl"
  },
  "homepage": "https://construction-pr01-solidcraft.netlify.app/",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev-server.mjs",
    "build:css": "postcss css/style.css --no-map -o dist/css/style.min.css && node scripts/verify-css-build.js",
    "build:js": "esbuild js/theme-init.js --bundle --minify --target=es2018 --format=iife --outfile=dist/js/theme-init.min.js && esbuild js/script.js --bundle --minify --target=es2018 --format=iife --outfile=dist/js/script.min.js && node scripts/verify-js-build.js",
    "build": "npm run build:css && npm run build:js",
    "build:dist": "node scripts/build-dist.js && npm run build && npm run build:sitemap && npm run build:sw",
    "build:sitemap": "cross-env SITE_URL=https://construction-pr01-solidcraft.netlify.app node scripts/generate-sitemap.mjs",
    "build:sw": "node scripts/generate-sw.js",
    "watch:css": "postcss css/style.css --watch --no-map -o dist/css/style.min.css",
    "watch:js": "esbuild js/theme-init.js --bundle --minify --target=es2018 --format=iife --outfile=dist/js/theme-init.min.js --watch=forever & esbuild js/script.js --bundle --minify --target=es2018 --format=iife --outfile=dist/js/script.min.js --watch=forever",
    "check:links": "node scripts/check-links.mjs",
    "check:assets": "node scripts/check-html-assets.mjs",
    "check:html": "npm run check:links && npm run check:assets",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:functional": "node scripts/qa-functional.mjs",
    "qa:sw": "node scripts/qa-sw-lifecycle.mjs",
    "qa:lighthouse": "npm run build:dist && node scripts/qa-lighthouse.mjs",
    "qa:lhci": "npm run qa:lighthouse",
    "check:predeploy": "npm run check:html && npm run qa:a11y",
    "images:build": "node scripts/images.js build",
    "images:clean": "node scripts/images.js clean",
    "format": "prettier -w \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier -c \"**/*.{html,css,js,json,md}\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "baseline-browser-mapping": "^2.10.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "cssnano": "^6.1.2",
    "esbuild": "^0.27.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.4.0",
    "prettier": "3.3.3",
    "sharp": "^0.35.3",
    "terser": "^5.31.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
