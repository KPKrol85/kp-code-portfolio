# Text files: one convention everywhere — LF in the repository and in the
# working tree, so line endings never show up as a diff.
* text=auto eol=lf

# Binary assets — never normalised, never diffed as text.
# Extensions confirmed by inspecting assets/; no archive formats are tracked.
*.avif  binary
*.ico   binary
*.jpg   binary
*.png   binary
*.webp  binary
*.woff2 binary
