{
  "name": "axiom-construction",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive construction company website (HTML/CSS/JS) with PWA, SEO, and accessibility — KP_Code.",
  "author": "Kamil Król — KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "frontend",
    "construction",
    "pwa",
    "seo",
    "accessibility",
    "vanilla-js",
    "kp_code"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "cssnano": "^7.1.1",
    "cssnano-cli": "^1.0.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^12.2.1",
    "pa11y": "^8.0.0",
    "sharp": "^0.33.5",
    "terser": "^5.44.0",
    "ttf2woff2": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "img:build": "node tools/images/build-images.mjs",
    "img:clean": "node tools/images/build-images.mjs --clean",
    "build:clean": "node tools/release/clean-dist.mjs",
    "build:css": "node tools/css/build-css.mjs",
    "min:css": "npm run build:css",
    "build:js": "node tools/js/build-js.mjs",
    "build:hash": "node tools/release/build-hash.mjs",
    "build:sw": "node tools/sw/build-sw.mjs",
    "build:sw:local": "node tools/sw/build-sw.mjs --profile=local",
    "build:sw:production": "node tools/sw/build-sw.mjs --profile=production",
    "build:dist": "node tools/release/build-dist.mjs",
    "build": "npm run build:clean && npm run build:css && npm run build:js && npm run build:hash && npm run build:sw:production && npm run build:dist",
    "serve": "http-server -c-1 -p 8080",
    "serve:dist": "http-server dist -c-1 -p 8080",
    "qa:lighthouse": "node tools/qa/run-lighthouse.mjs",
    "qa:a11y": "node tools/qa/run-pa11y.mjs",
    "qa:references": "node tools/qa/check-references.mjs",
    "qa": "npm run qa:lighthouse && npm run qa:a11y",
    "build:head": "node tools/html/build-head.mjs",
    "lint": "eslint js tools tests sw.template.js vitest.config.mjs",
    "test": "vitest run"
  }
}
