/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com/recaptcha/; base-uri 'self'; form-action 'self'

# Production bundles emitted by `npm run build` at the deployment root. Their
# filenames carry a SHA-256 digest of their own bytes, so the exact rules are
# only known per build. build:dist replaces everything between the markers
# below with the rules for the bundles that build actually produced; this
# canonical file declares the block and nothing else. Keep exactly one block.

# >>> AXIOM PRODUCTION BUNDLE CACHE RULES >>>
# Replaced by build:dist from dist/build-manifest.json. No rule here: the
# repository root serves css/main.css and js/main.js directly, and no hashed
# bundle exists until a release build names one.
# <<< AXIOM PRODUCTION BUNDLE CACHE RULES <<<

# The standalone source scripts `build:dist` publishes beside the bundles, and
# the only unversioned source URLs the deployment serves: every stylesheet layer
# and every module of the `js/main.js` graph reaches production inside a
# content-addressed bundle instead. These two keep fixed URLs whose contents can
# change between deploys, so each response stays fresh briefly, then revalidates.

/js/theme-init.js
  Cache-Control: public, max-age=300, must-revalidate

/js/offline.js
  Cache-Control: public, max-age=300, must-revalidate

# Self-hosted font releases. The URL carries the release version in both the
# directory and the filename (`lato-v25-latin/lato-v25-latin-regular.woff2`),
# so a new release lands on a new URL. This is the only versioned asset group.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images use fixed names that encode dimensions, not content, and can be
# replaced under the same URL. Each response stays fresh for one week before
# becoming stale.

/assets/img/*
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
