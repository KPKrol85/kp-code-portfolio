{
  "name": "atelier-no-02-restaurant",
  "version": "1.0.0",
  "description": "Atelier No.02 – nowoczesna strona internetowa restauracji fine dining, zaprojektowana z myślą o wysokiej jakości doświadczenia użytkownika, dostępności i wydajności.",
  "author": "Kamil Król | KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "KP_Code",
    "Kamil Król",
    "frontend",
    "portfolio",
    "restaurant",
    "fine dining",
    "gastronomy",
    "HTML",
    "CSS",
    "JavaScript",
    "responsive",
    "accessibility",
    "SEO",
    "PWA"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "npm run build:static && npm run build:css && npm run build:js && npm run qa:dist:integrity",
    "preview": "http-server dist -a 127.0.0.1 -p 5173 -c-1",
    "qa": "npm run lint && npm run qa:source && npm run qa:html && npm run qa:server",
    "qa:dist": "npm run qa:dist:integrity && npm run qa:dist:html && npm run qa:dist:server",
    "build:static": "node scripts/build-dist.js",
    "build:css": "postcss css/style.css -o dist/css/style.min.css --no-map",
    "build:js": "esbuild js/script.js js/core.js --bundle --minify --outdir=dist/js --out-extension:.js=.min.js --target=es2018",
    "images:build": "node scripts/images/build-images.js",
    "lint": "eslint \"js/**/*.js\" \"sw.js\" \"scripts/**/*.js\"",
    "qa:source": "node scripts/validate-dist.js --source",
    "qa:html": "node scripts/qa-html.js",
    "qa:links": "node scripts/qa-links.js",
    "qa:links:external": "node scripts/qa-links.js --external",
    "qa:a11y": "pa11y-ci",
    "qa:server": "node scripts/qa-server.js",
    "qa:dist:integrity": "node scripts/validate-dist.js",
    "qa:dist:html": "html-validate \"dist/*.html\"",
    "qa:dist:server": "node scripts/qa-server.js --dist"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.0",
    "cross-env": "^10.1.0",
    "cssnano": "^6.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "fast-glob": "^3.3.2",
    "html-validate": "^9.3.0",
    "http-server": "^14.1.1",
    "linkinator": "^7.5.3",
    "pa11y-ci": "^3.1.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "sharp": "^0.33.5",
    "start-server-and-test": "^2.0.5"
  }
}
