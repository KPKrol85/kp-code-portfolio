{
  "name": "ambre-gastronomy-project-01",
  "version": "1.0.0",
  "private": true,
  "description": "Ambre — front-end project (HTML, CSS, Vanilla JS). Live demo: https://gastronomy-pr01-ambre.netlify.app/",
  "author": "Kamil Król | KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "live-server --host=127.0.0.1 --port=4183 --ignore=node_modules,dist",
    "build": "node scripts/build-dist.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:text",
    "lint:js": "eslint --max-warnings 0 \"js/**/*.js\" \"scripts/**/*.mjs\"",
    "lint:css": "stylelint --max-warnings 0 \"css/**/*.css\"",
    "lint:text": "node scripts/text-lint.mjs",
    "qa": "npm run qa:fast && npm run qa:nojs && npm run test:e2e && npm run qa:a11y && npm run qa:lighthouse",
    "qa:fast": "npm run lint && npm run qa:html && npm run qa:links && npm run qa:seo && npm run qa:schema && npm run qa:csp",
    "qa:html": "html-validate index.html menu.html galeria.html cookies.html polityka-prywatnosci.html regulamin.html 404.html offline.html",
    "qa:links": "node scripts/qa-links.mjs",
    "qa:seo": "node scripts/qa-seo.mjs",
    "qa:schema": "node scripts/schema-policy-check.mjs",
    "qa:csp": "node scripts/update-csp-hashes.mjs --check",
    "qa:service-worker": "node scripts/qa-service-worker.mjs",
    "qa:nojs": "node scripts/qa-nojs-e2e.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "qa:server": "node scripts/check-server-prod.mjs",
    "test:e2e": "npm run test:e2e:reservation && npm run test:e2e:demo-legal && npm run test:e2e:scroll-to-top && npm run test:e2e:legal-tables && npm run test:e2e:lightbox && npm run test:e2e:gallery-status",
    "test:e2e:reservation": "node scripts/qa-reservation-e2e.mjs",
    "test:e2e:demo-legal": "node scripts/qa-demo-legal-e2e.mjs",
    "test:e2e:scroll-to-top": "node scripts/qa-scroll-to-top-e2e.mjs",
    "test:e2e:legal-tables": "node scripts/qa-legal-tables-e2e.mjs",
    "test:e2e:lightbox": "node scripts/qa-lightbox-e2e.mjs",
    "test:e2e:gallery-status": "node scripts/qa-gallery-status-e2e.mjs",
    "csp:hash": "node scripts/update-csp-hashes.mjs",
    "img:opt": "node scripts/optimize-images.mjs",
    "img:webp": "node scripts/optimize-images.mjs --webp",
    "img:avif": "node scripts/optimize-images.mjs --avif",
    "img:clean": "node -e \"require('fs').rmSync('assets/img/_optimized', { recursive: true, force: true })\"",
    "img:verify": "node scripts/img-verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "autoprefixer": "^10.4.24",
    "cssnano": "^7.1.1",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.0",
    "html-validate": "^10.5.0",
    "live-server": "^1.2.2",
    "playwright": "^1.55.0",
    "postcss": "^8.5.26",
    "postcss-import": "^16.1.1",
    "sharp": "^0.35.4",
    "stylelint": "^16.7.0",
    "stylelint-config-recommended": "^14.0.0"
  }
}
